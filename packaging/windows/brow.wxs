<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- brow MSI installer (Phase 5).
       Built with the WiX 6 CLI on Windows runners:
         BROW_PAYLOAD=C:\staging\brow \
         BROW_ICON=C:\staging\icons\brow.ico \
         wix build -arch x64 -d BrowVersion=0.5.0 \
           -out brow-0.5.0-x64.msi packaging/windows/brow.wxs
       The payload directory must contain brow.exe, a resources\ tree and
       the runtime DLLs (ANGLE/GStreamer/MSVC) staged next to brow.exe
       Payload/icon paths come from environment variables so the same .wxs
       works locally and in CI:
         BROW_PAYLOAD  staging dir with brow.exe + resources\ + *.dll
         BROW_ICON     packaging/icons/brow.ico

       Harvesting note (WiX v4+ schema): <Files> is only valid as a child of
       Feature/Directory/Fragment/... — NOT of <Component> (error WIX0005).
       Under <Feature>, harvested components attach to that feature
       automatically (Compiler.ParseFilesElement → ComplexReferenceParentType.
       Feature), so no ComponentRef is needed. The harvester preserves
       subdirectory structure relative to the pattern's literal directory
       portion (HarvestFilesAndPayloadsCommand.GetWildcardFiles), so:
         * "...resources\**" + Directory=INSTALLDIR + Subdirectory=resources
           → INSTALLDIR\resources\<tree> (Subdirectory avoids flattening the
           resources root into INSTALLDIR).
         * "...payload\*.dll" + Directory=INSTALLDIR → DLLs beside brow.exe.
       -->
  <?define BrowVersion="0.1.0"?>

  <Package Name="brow"
           Manufacturer="brow engineering"
           Version="$(BrowVersion)"
           UpgradeCode="6B77C64D-8A3B-4E5B-9F0A-2C1D3E4F5A6B"
           Scope="perMachine"
           Language="1033"
           Codepage="1252"
           InstallerVersion="200">

    <SummaryInformation Keywords="Installer;browser;privacy;servo"
                        Description="brow — ultra-lightweight, privacy-first web browser" />

    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="brow">
        <Component Id="BrowExe"
                   Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D"
                   Bitness="always64">
          <File Id="BrowExeFile"
                Name="brow.exe"
                DiskId="1"
                Source="$(env.BROW_PAYLOAD)\brow.exe"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BrowMenuDir" Name="brow">
        <Component Id="BrowShortcut"
                   Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
          <Shortcut Id="BrowStartMenuShortcut"
                    Name="brow"
                    Description="Ultra-lightweight, privacy-first web browser"
                    Target="[INSTALLDIR]brow.exe"
                    WorkingDirectory="INSTALLDIR"
                    Icon="browProduct.ico" />
          <RemoveFolder Id="RemoveBrowMenuDir" On="both" />
          <RegistryValue Root="HKCU"
                         Key="Software\brow"
                         Type="string"
                         Value=""
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="BrowExe" />
      <ComponentRef Id="BrowShortcut" />
      <!-- WiX v4+ harvest entries: see the header comment for why these
           live under Feature (not Component) and why Subdirectory is
           required to keep the resources\ tree nested. -->
      <Files Include="$(env.BROW_PAYLOAD)\resources\**"
             Directory="INSTALLDIR"
             Subdirectory="resources" />
      <Files Include="$(env.BROW_PAYLOAD)\*.dll"
             Directory="INSTALLDIR" />
      <!-- brow (v0.6.1): fallback binary + bundled Noto UI fonts (Arabic). -->
      <Files Include="$(env.BROW_PAYLOAD)\brow-classic.exe"
             Directory="INSTALLDIR" />
      <Files Include="$(env.BROW_PAYLOAD)\fonts\**"
             Directory="INSTALLDIR"
             Subdirectory="fonts" />
    </Feature>

    <Icon Id="browProduct.ico" SourceFile="$(env.BROW_ICON)" />
    <Property Id="ARPPRODUCTICON" Value="browProduct.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/salim77007j/brow" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/salim77007j/brow" />
  </Package>
</Wix>
