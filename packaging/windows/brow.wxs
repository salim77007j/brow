<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- brow MSI installer (Phase 5).
       Built with the WiX 6 CLI on Windows runners:
         BROW_PAYLOAD=C:\staging\brow \
         BROW_ICON=C:\staging\icons\brow.ico \
         wix build -arch x64 -d BrowVersion=0.5.0 \
           -out brow-0.5.0-x64.msi packaging/windows/brow.wxs
       The payload directory must contain brow.exe, a resources\ tree and
       the runtime DLLs (ANGLE/GStreamer/MSVC) staged next to brow.exe
       (identical contract to the Linux packages). Payload/icon paths come
       from environment variables so the same .wxs works locally and in CI:
         BROW_PAYLOAD  staging dir with brow.exe + resources\
         BROW_ICON     packaging/icons/brow.ico
       -->
  <?define BrowVersion="0.1.0"?>

  <Package Name="brow"
           Manufacturer="brow engineering"
           Version="$(BrowVersion)"
           UpgradeCode="6B77C64D-8A3B-4E5B-9F0A-2C1D3E4F5A6B"
           Scope="perMachine"
           Language="1033"
           Codepage="1252"
           InstallerVersion="200">

    <SummaryInformation Keywords="Installer;browser;privacy;servo"
                        Description="brow — ultra-lightweight, privacy-first web browser" />

    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="brow">
        <Component Id="BrowExe"
                   Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D"
                   Bitness="always64">
          <File Id="BrowExeFile"
                Name="brow.exe"
                DiskId="1"
                Source="$(env.BROW_PAYLOAD)\brow.exe"
                KeyPath="yes" />
        </Component>
        <Directory Id="ResourcesDir" Name="resources">
          <Component Id="BrowResources"
                     Guid="C3D4E5F6-A7B8-4C9D-8E1F-2A3B4C5D6E7F"
                     Bitness="always64">
            <!-- Harvests every file under resources\ recursively into this
                 component; WiX expands them to File rows at compile time. -->
            <Files Include="$(env.BROW_PAYLOAD)\resources\**" />
          </Component>
        </Directory>
        <Component Id="BrowRuntimeDlls"
                   Guid="D4E5F6A7-B8C9-4D0E-9F1A-3B4C5D6E7F8A"
                   Bitness="always64">
          <!-- Runtime DLLs (ANGLE, GStreamer libs + plugin subset, MSVC CRT)
               staged next to brow.exe in the payload. Without them the
               installed brow.exe cannot start on machines without GStreamer
               installed. -->
          <Files Include="$(env.BROW_PAYLOAD)\*.dll" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BrowMenuDir" Name="brow">
        <Component Id="BrowShortcut"
                   Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
          <Shortcut Id="BrowStartMenuShortcut"
                    Name="brow"
                    Description="Ultra-lightweight, privacy-first web browser"
                    Target="[INSTALLDIR]brow.exe"
                    WorkingDirectory="INSTALLDIR"
                    Icon="browProduct.ico" />
          <RemoveFolder Id="RemoveBrowMenuDir" On="both" />
          <RegistryValue Root="HKCU"
                         Key="Software\brow"
                         Type="string"
                         Value=""
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="BrowExe" />
      <ComponentRef Id="BrowResources" />
      <ComponentRef Id="BrowRuntimeDlls" />
      <ComponentRef Id="BrowShortcut" />
    </Feature>

    <Icon Id="browProduct.ico" SourceFile="$(env.BROW_ICON)" />
    <Property Id="ARPPRODUCTICON" Value="browProduct.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/salim77007j/brow" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/salim77007j/brow" />
  </Package>
</Wix>
