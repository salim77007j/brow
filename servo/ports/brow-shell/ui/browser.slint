// brow browser chrome — Slint UI definition.
// Rendered by the software renderer into the chrome strip above the
// engine-owned content windows. All user-visible strings come from
// brow-shell-core's L10n (en + ar) via the `i18n` struct; `rtl` mirrors the
// layout direction (Arabic is a first-class locale in brow).

import { LineEdit, ScrollView } from "std-widgets.slint";

export struct TabInfo {
    id: int,
    title: string,
    active: bool,
    sleeping: bool,
    discarded: bool,
    audible: bool,
    loading: bool,
}

export struct BookmarkInfo {
    id: int,
    title: string,
    url: string,
}

export struct HistoryInfo {
    title: string,
    url: string,
    visits: int,
}

export struct DownloadInfo {
    id: int,
    name: string,
    progress: float,
    state-text: string,
    done: bool,
}

export struct SettingsInfo {
    locale-label: string,
    theme-label: string,
    engine-label: string,
    sleep-after: string,
    per-tab-budget: string,
    total-budget: string,
    block-ads: bool,
    dnt: bool,
    restore-session: bool,
    hidden-fps: string,
    // brow (v0.6.1): new privacy settings state.
    block-third-party-cookies: bool,
    block-cname-tracking: bool,
    fingerprint-label: string,
}

export struct L10nStrings {
    new-tab: string,
    close-tab: string,
    address-hint: string,
    back: string,
    forward: string,
    reload: string,
    home: string,
    bookmarks: string,
    history: string,
    downloads: string,
    settings: string,
    search-bookmarks: string,
    search-history: string,
    clear-history: string,
    no-downloads: string,
    memory: string,
    memory-per-tab: string,
    memory-total: string,
    tabs: string,
    tab-slept: string,
    menu: string,
    language: string,
    search-engine: string,
    block-ads: string,
    dnt: string,
    restore-session: string,
    dns-over-https: string,
    min-tls: string,
    // brow (v0.6.1): new privacy settings strings.
    third-party-cookies: string,
    fingerprint-defense: string,
    cname-tracking: string,
}

export component IconText inherits Text {
    in property <string> glyph;
    font-size: 15px;
    color: #cfd6e4;
    vertical-alignment: center;
    horizontal-alignment: center;
    text: root.glyph;
}

export component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    width: 30px;
    border-radius: 6px;
    background: active ? #2e6ff2 : (ta.has-hover ? #262b38 : transparent);
    opacity: enabled ? 1.0 : 0.35;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    IconText {
        glyph: root.glyph;
        width: parent.width;
        height: parent.height;
    }
}

export component TabButton inherits Rectangle {
    in property <TabInfo> tab;
    in property <bool> rtl;
    callback activated();
    callback closed();

    height: 32px;
    border-radius: 7px;
    background: tab.active ? #262b38 : (t.has-hover ? #1d212c : transparent);

    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 2px;

        Rectangle {
            width: 7px;
            height: 7px;
            y: 12px;
            border-radius: 3.5px;
            background: #f2b32e;
            visible: tab.sleeping;
        }
        Text {
            text: tab.discarded ? "◌ " + tab.title
                : tab.sleeping ? "☾ " + tab.title
                : (tab.audible ? "♪ " : "") + tab.title;
            font-size: 12px;
            color: tab.active ? #f0f3fa : #a8b0c0;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            background: c.has-hover ? #3a4152 : transparent;
            c := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.closed(); }
            }
            IconText { glyph: "×"; width: parent.width; height: parent.height; font-size: 13px; }
        }
    }
}

export component BrowserChrome inherits Window {
    preferred-width: 1240px;
    preferred-height: 88px;
    min-width: 640px;
    min-height: 88px;
    background: #14161c;
    // brow (v0.6.1, fix 4.2): ship our own typography. Noto Sans is bundled
    // with the binary and installed into the user font dir at startup;
    // Arabic codepoints fall back per-glyph to the bundled Noto Sans Arabic.
    default-font-family: "Noto Sans";

    // ---- state ----------------------------------------------------------
    in property <[TabInfo]> tabs;
    in property <[BookmarkInfo]> bookmarks;
    in property <[HistoryInfo]> history-entries;
    in property <[DownloadInfo]> downloads;
    in property <SettingsInfo> settings;
    in property <L10nStrings> i18n;

    in property <bool> rtl;
    in property <string> address;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> loading;
    in property <bool> bookmarked;
    in property <int> panel-kind; // 0 none, 1 bookmarks, 2 history, 3 downloads, 4 settings, 5 memory
    in property <string> memory-summary;
    in property <int> sleeping-count;

    // ---- callbacks ------------------------------------------------------
    callback tab-activated(int);
    callback tab-closed(int);
    callback new-tab();
    callback go-back();
    callback go-forward();
    callback go-reload();
    callback go-home();
    callback address-submitted(string);
    callback bookmark-toggled();
    callback panel-toggled(int);
    callback panel-item-opened(string);
    callback panel-item-removed(int);
    callback history-cleared();
    callback setting-toggled(string);
    callback setting-cycled(string);
    callback tab-sleep-hotkey();

    // ---- helpers --------------------------------------------------------
    function panel-title() -> string {
        panel-kind == 1 ? i18n.bookmarks :
        panel-kind == 2 ? i18n.history :
        panel-kind == 3 ? i18n.downloads :
        panel-kind == 4 ? i18n.settings :
        i18n.memory;
    }

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        // ==== toolbar row =================================================
        // brow (v0.6.1, fix 4.3): nav glyph semantics follow the locale — in
        // RTL the back arrow points right and forward points left. Padding
        // mirrors as well. (Full layout-order mirroring is tracked as
        // next-step work; Slint 1.17 has no first-class layout direction.)
        HorizontalLayout {
            height: 34px;
            spacing: 4px;

            ToolButton { glyph: root.rtl ? "▶" : "◀"; enabled: root.can-go-back; clicked => { root.go-back(); } }
            ToolButton { glyph: root.rtl ? "◀" : "▶"; enabled: root.can-go-forward; clicked => { root.go-forward(); } }
            ToolButton {
                glyph: root.loading ? "×" : "⟳";
                clicked => { root.loading ? root.go-reload() : root.go-reload(); }
            }
            ToolButton { glyph: "⌂"; clicked => { root.go-home(); } }

            Rectangle {
                border-radius: 8px;
                background: #1d212c;
                border-width: 1px;
                border-color: #2a3040;
                vertical-stretch: 1;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Rectangle {
                        width: 18px;
                        IconText { glyph: "⌕"; width: parent.width; height: parent.height; color: #7a8398; }
                    }
                    address-edit := LineEdit {
                        text: root.address;
                        placeholder-text: root.i18n.address-hint;
                        vertical-stretch: 1;
                        accepted(text) => { root.address-submitted(text); }
                        font-size: 12px;
                    }
                }
            }

            ToolButton {
                glyph: root.bookmarked ? "★" : "☆";
                active: root.bookmarked;
                clicked => { root.bookmark-toggled(); }
            }
            ToolButton { glyph: "☰"; clicked => { root.panel-toggled(4); } }
        }

        // ==== tab strip ===================================================
        HorizontalLayout {
            height: 34px;
            spacing: 4px;

            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                tabs-row := HorizontalLayout {
                    spacing: 4px;
                    for tab in root.tabs: TabButton {
                        tab: tab;
                        rtl: root.rtl;
                        min-width: 140px;
                        max-width: 200px;
                        activated => { root.tab-activated(tab.id); }
                        closed => { root.tab-closed(tab.id); }
                    }
                }
            }

            Rectangle {
                width: root.sleeping-count > 0 ? 120px : 0px;
                border-radius: 6px;
                background: #1d212c;
                Text {
                    text: root.sleeping-count + " " + root.i18n.tabs + " · ☾";
                    font-size: 11px;
                    color: #f2b32e;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            ToolButton { glyph: "＋"; clicked => { root.new-tab(); } }
        }

        // ==== side panel ==================================================
        if (root.panel-kind > 0): Rectangle {
            border-radius: 8px;
            background: #181b24;
            min-height: 220px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    Text {
                        text: root.panel-title();
                        font-size: 13px;
                        font-weight: 700;
                        color: #f0f3fa;
                        horizontal-stretch: 1;
                        horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        vertical-alignment: center;
                    }
                    if root.panel-kind == 2: ToolButton {
                        glyph: "⌫";
                        clicked => { root.history-cleared(); }
                    }
                    ToolButton { glyph: "×"; clicked => { root.panel-toggled(0); } }
                }

                if root.panel-kind == 1 || root.panel-kind == 2: LineEdit {
                    placeholder-text: root.panel-kind == 1 ? root.i18n.search-bookmarks : root.i18n.search-history;
                    font-size: 12px;
                    height: 30px;
                    accepted(text) => { root.panel-item-opened(text); }
                }

                Rectangle {
                    border-radius: 6px;
                    background: #14161c;
                    vertical-stretch: 1;
                    if root.panel-kind == 1: ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            for bm in root.bookmarks: Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: bmt.has-hover ? #222633 : transparent;
                                bmt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.panel-item-opened(bm.url); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 6px;
                                    Text {
                                        text: bm.title == "" ? bm.url : bm.title;
                                        font-size: 12px;
                                        color: #cfd6e4;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    }
                                    ToolButton {
                                        glyph: "🗑";
                                        width: 24px;
                                        clicked => { root.panel-item-removed(bm.id); }
                                    }
                                }
                            }
                        }
                    }
                    if root.panel-kind == 2: ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            for h in root.history-entries: Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: ht.has-hover ? #222633 : transparent;
                                ht := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.panel-item-opened(h.url); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 6px;
                                    Text {
                                        text: (h.visits > 1 ? h.visits + "×  " : "") + (h.title == "" ? h.url : h.title);
                                        font-size: 12px;
                                        color: #cfd6e4;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    }
                                }
                            }
                        }
                    }
                    if root.panel-kind == 3: ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            if root.downloads.length == 0: Text {
                                text: root.i18n.no-downloads;
                                color: #7a8398;
                                font-size: 12px;
                            }
                            for d in root.downloads: Rectangle {
                                height: 34px;
                                border-radius: 5px;
                                background: #1a1e29;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: d.name;
                                        font-size: 12px;
                                        color: #cfd6e4;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 90px;
                                        height: 6px;
                                        y: 14px;
                                        border-radius: 3px;
                                        background: #262b38;
                                        Rectangle {
                                            width: parent.width * d.progress;
                                            border-radius: 3px;
                                            background: #2e6ff2;
                                        }
                                    }
                                    Text {
                                        text: d.state-text;
                                        font-size: 11px;
                                        color: #7a8398;
                                        width: 90px;
                                    }
                                }
                            }
                        }
                    }
                    if root.panel-kind == 4: ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;
                            property <color> label-color: #a8b0c0;
                            property <length> row-height: 30px;

                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.language; font-size: 12px; color: label-color; width: 160px; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.locale-label; width: 90px; clicked => { root.setting-cycled("locale"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.search-engine; font-size: 12px; color: label-color; width: 160px; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.engine-label; width: 90px; clicked => { root.setting-cycled("search_engine"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.block-ads; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.block-ads ? "✓" : "✗"; width: 60px; clicked => { root.setting-toggled("block_ads"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.dnt; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.dnt ? "✓" : "✗"; width: 60px; clicked => { root.setting-toggled("dnt"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.restore-session; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.restore-session ? "✓" : "✗"; width: 60px; clicked => { root.setting-toggled("restore_session"); } }
                            }
                            // brow (v0.6.1): the privacy section — every
                            // switch drives a real engine pref (fix 3.6).
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.third-party-cookies; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.block-third-party-cookies ? "✓" : "✗"; width: 60px; clicked => { root.setting-toggled("block_third_party_cookies"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.cname-tracking; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.block-cname-tracking ? "✓" : "✗"; width: 60px; clicked => { root.setting-toggled("block_cname_tracking"); } }
                            }
                            HorizontalLayout { spacing: 8px; height: row-height;
                                Text { text: root.i18n.fingerprint-defense; font-size: 12px; color: label-color; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                ToolButton { glyph: root.settings.fingerprint-label; width: 90px; clicked => { root.setting-cycled("fingerprint_defense"); } }
                            }
                        }
                    }
                    if root.panel-kind == 5: Text {
                        text: root.memory-summary;
                        font-size: 12px;
                        color: #cfd6e4;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
